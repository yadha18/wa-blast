# Port Railway assigns automatically via $PORT — safe to leave unset locally.
PORT=4000

# Comma-separated list of allowed frontend origins (CORS + Socket.io).
# Local dev + your deployed frontend, e.g.:
# CLIENT_ORIGIN=http://localhost:5173,https://wa-blast.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Directory for persistent data (WhatsApp session, SQLite DB, banner uploads).
# Leave unset locally. On Railway, set this to your attached Volume's mount
# path (e.g. /data) — otherwise the WhatsApp session and DB are wiped on
# every redeploy.
# DATA_DIR=/data
